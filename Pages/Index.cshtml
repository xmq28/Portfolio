@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section id="home" class="hero">
    <canvas id="particles-canvas"></canvas>
    <div class="hero-content">
        <h1 class="hero-title fade-in">
            <span class="text-line">Hi, I'm</span>
            <span class="text-line highlight-name">Malak Alsaeed</span>
        </h1>
        <h2 class="hero-subtitle fade-in-delay">
            <span class="typing-text">Full-Stack Engineer</span>
        </h2>
        <p class="hero-description fade-in-delay-2">
            Building reliable backend systems, APIs, enterprise platforms, and automation workflows
        </p>
        <div class="hero-buttons fade-in-delay-3">
            <a href="#projects" class="cta-button primary">
                <span>View My Work</span>
                <i class="fas fa-arrow-right"></i>
            </a>
            <a href="#contact" class="cta-button secondary">
                <span>Get In Touch</span>
                <i class="fas fa-paper-plane"></i>
            </a>
            <a href="#" class="cta-button tertiary" data-resume-link>
                <span>Download Resume</span>
                <i class="fas fa-download"></i>
            </a>
        </div>
    </div>
    <div class="scroll-indicator">
        <div class="mouse">
            <div class="wheel"></div>
        </div>
        <p>Scroll Down</p>
    </div>
</section>

<!-- About Section -->
<section id="about" class="about">
    <div class="container">
        <h2 class="section-title">
            <span class="title-number">01.</span> About Me
            <span class="title-decoration"></span>
        </h2>
        <div class="about-grid">
            <div class="about-content">
                <div class="about-intro">
                    <p class="about-text highlight-text">
                        <span class="emoji-icon">👋</span> I design and build digital products that turn complex workflows into
                        clear, dependable systems. I work across web apps, APIs, and internal tools that help teams move faster
                        with less friction.
                    </p>
                    <p class="about-text">
                        From shaping requirements to supporting a release in production, I care about the details that make
                        software last: thoughtful architecture, secure integrations, useful reporting, and a smooth experience
                        for the people who rely on it. My toolkit includes <span class="text-highlight">C#, .NET, ASP.NET Core, Go, Django, React, TypeScript, SQL Server, PostgreSQL, PHP, Laravel, and Microsoft Entra ID</span>.
                    </p>
                    <p class="about-text">
                        I’m especially drawn to products that connect people, data, and day-to-day operations: secure
                        administrative portals, automation, dashboards, and systems that make important work easier to understand
                        and act on.
                    </p>
                </div>
            </div>

            <div class="about-visual">
                <div class="stats-container">
                    <div class="stat-box">
                        <div class="stat-icon">🚀</div>
                        <div class="stat-number" data-target="13">13</div>
